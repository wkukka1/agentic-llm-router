{
  "title": "Agentic Orchestrator Architecture",
  "direction": "TB",
  "nodes": [
    {
      "id": "user",
      "label": "Prompt\n(str | messages | Conversation)",
      "type": "user",
      "color": "gray",
      "x": 220,
      "y": 126
    },
    {
      "id": "begin",
      "label": "AgenticRouter.run\n_begin: latest turn, history,\nper-run state (max_calls, alpha)",
      "type": "component",
      "color": "green",
      "x": 730,
      "y": 126
    },
    {
      "id": "route",
      "label": "route_decision\nRouterModel (NIRT / kNN)\nscores the narrow, ClientRegistry-dispatchable pool",
      "type": "component",
      "color": "purple",
      "x": 1240,
      "y": 126
    },
    {
      "id": "triage",
      "label": "Triage\nHeuristic (q* < 0.55 or multi-part)\n/ LLMTriage -> TriageDecision{mode}",
      "type": "component",
      "color": "yellow",
      "x": 1750,
      "y": 126
    },
    {
      "id": "solve",
      "label": "_solve(prompt, depth, decision)",
      "type": "component",
      "color": "green",
      "x": 2260,
      "y": 126
    },
    {
      "id": "direct",
      "label": "_answer_directly -> _call_model -> _leaf\n(single mode, or depth >= max_depth)",
      "type": "component",
      "color": "blue",
      "x": 2770,
      "y": 126
    },
    {
      "id": "gate",
      "label": "decompose_plan gate: _skip_decomposition\nlooks_atomic (root) / is_multipart (sub-task)\nonly orchestrator: PlanOrchestratorBridge\n(no recursive/tool-calling alt - orchestrator.py deleted)",
      "type": "component",
      "color": "yellow",
      "x": 415,
      "y": 637
    },
    {
      "id": "planner",
      "label": "LLMDecomposer.plan(prompt) -> parse_plan_lines\n'2. [after 1] [150-300 words, max 450] task'\nnumbered lines only; dedupe -> list[SubTask]",
      "type": "component",
      "color": "red",
      "x": 220,
      "y": 849
    },
    {
      "id": "route0",
      "label": "Plan-time routing: RoutedOrchestrator.plan\none batched route_text (_route_batch)\nper sub-prompt",
      "type": "component",
      "color": "purple",
      "x": 610,
      "y": 849
    },
    {
      "id": "plan",
      "label": "Plan: PlanStep DAG (_new_step)\ndependencies + word budget\n(budget_mid_tokens / DEFAULT_BUDGET)",
      "type": "component",
      "color": "green",
      "x": 220,
      "y": 1049
    },
    {
      "id": "fc",
      "label": "Forecast/admit: RoutedOrchestrator._score\nPlanForecaster / RouterPlanForecaster.score_plan\ncost / quality / latency",
      "type": "component",
      "color": "purple",
      "x": 610,
      "y": 1049
    },
    {
      "id": "ledger",
      "label": "BudgetLedger.resize\nreserve plan.budget_estimate()",
      "type": "database",
      "color": "orange",
      "x": 1000,
      "y": 1037
    },
    {
      "id": "refuse",
      "label": "over_budget\nTaskStatus.TERMINATED, error_code=over_budget\nnothing ran, nothing spent",
      "type": "component",
      "color": "red",
      "x": 220,
      "y": 1249
    },
    {
      "id": "levels",
      "label": "RoutedOrchestrator.execute(plan)\n_levels: topological groups by satisfied deps\nparallel within a level (ThreadPoolExecutor)",
      "type": "component",
      "color": "green",
      "x": 1203,
      "y": 1476
    },
    {
      "id": "blocked",
      "label": "_blocked_call\nerror=dependency_failed, no model call\n(ROUTEDORCHESTRATOR-004: still counted in models_used())",
      "type": "component",
      "color": "gray",
      "x": 220,
      "y": 1676
    },
    {
      "id": "assign",
      "label": "_assign_models: route_late\nre-routes any non-pinned step whose contextual\nprompt changed (escalated steps stay pinned)\n(ROUTEDORCHESTRATOR-001: bypasses budget re-admission\nROUTEDORCHESTRATOR-003: dep context not in input estimate)",
      "type": "component",
      "color": "purple",
      "x": 615,
      "y": 1700
    },
    {
      "id": "call",
      "label": "_run_step -> agent._call_model\n+ budget_instruction(step.budget)\nmax_tokens = budget_max_tokens\n(TOKENS_PER_WORD=1.35 x SAFETY_FACTOR=2.0 = 2.7x)",
      "type": "component",
      "color": "blue",
      "x": 615,
      "y": 1936
    },
    {
      "id": "synth",
      "label": "Synthesize: self.synthesize(task.prompt, subcalls)\nderive_final_budget = 60% of step budgets\nonly successful answers\n(ROUTEDORCHESTRATOR-002: synth + judge calls\nnever charged to the budget ledger)",
      "type": "component",
      "color": "red",
      "x": 1010,
      "y": 1700
    },
    {
      "id": "check",
      "label": "Quality check: self.checker (QualityChecker)\nparse_verdict -> QualityVerdict\nVERDICT/SCORE/WEAK_STEPS/FOLLOW_UPS/ISSUES\npass_score default 7.0",
      "type": "component",
      "color": "yellow",
      "x": 1010,
      "y": 1936
    },
    {
      "id": "best",
      "label": "Track best round: self.best\npassed > unverified > judged-failing,\nthen score (later round wins ties)",
      "type": "component",
      "color": "green",
      "x": 1010,
      "y": 2148
    },
    {
      "id": "escalate",
      "label": "Escalate weak + failed steps (_escalate/_escalation_pick)\nnever a previously-tried model\ncheapest stronger, else best untried, else exhausted\n-> pinned (stays pinned through route_late)",
      "type": "component",
      "color": "purple",
      "x": 1795,
      "y": 1688
    },
    {
      "id": "deps_clear",
      "label": "Dependents of re-run steps (_dependents)\nlose cached output -> re-run\nwith fresh context (not escalated)",
      "type": "component",
      "color": "blue",
      "x": 1795,
      "y": 1900
    },
    {
      "id": "follow",
      "label": "Checker follow-ups -> new PlanSteps\n(_follow_up_steps); [after N] = reviewed step N\ncapped at limits.max_fanout (default 8); unscorable dropped",
      "type": "component",
      "color": "blue",
      "x": 1795,
      "y": 2100
    },
    {
      "id": "keep",
      "label": "Every other step\nkeeps its paid output",
      "type": "component",
      "color": "gray",
      "x": 1600,
      "y": 2288
    },
    {
      "id": "nochange",
      "label": "_nothing_to_repair: round changes nothing\n-> short-circuit, no re-synthesis, no re-judge",
      "type": "component",
      "color": "gray",
      "x": 1955,
      "y": 2288
    },
    {
      "id": "revised",
      "label": "replan(plan) -> _next_plan\nprevious plan + repair instructions\nre-score -> reserve -> execute (next round)",
      "type": "component",
      "color": "green",
      "x": 1600,
      "y": 2476
    },
    {
      "id": "stop_budget",
      "label": "Repair refused over budget\n-> best round returned\n(PLANORCHESTRATORBRIDGE-001: an all-failed round\nrefused this way calls the synthesizer with no sub-answers)",
      "type": "component",
      "color": "red",
      "x": 1405,
      "y": 2688
    },
    {
      "id": "stop_calls",
      "label": "max_calls ran out inside a helper call\n-> best round, stopped_early",
      "type": "component",
      "color": "red",
      "x": 1795,
      "y": 2664
    },
    {
      "id": "stop_cap",
      "label": "max_replans reached (limits.max_replans, default 2)\n-> best round, flagged failed",
      "type": "component",
      "color": "red",
      "x": 2185,
      "y": 2664
    },
    {
      "id": "bridge_out",
      "label": "PlanOrchestratorBridge.run\nmaps ExecutionResult -> (answer, [SubCall])\nback in _solve: becomes a branch SubCall",
      "type": "component",
      "color": "green",
      "x": 1403,
      "y": 2900
    },
    {
      "id": "result",
      "label": "_result builds AgenticResult\nsteps (superseded marked), cost (total_cost over leaves),\nplans (one dict per revision), quality_check, helper_calls",
      "type": "component",
      "color": "green",
      "x": 1403,
      "y": 3100
    },
    {
      "id": "helpers",
      "label": "Routed helpers: decomposer / synthesizer / judge\n= cheapest pool model with q >= min_quality\n(AgenticRouter.decompose gate vs runaway re-splitting)",
      "type": "component",
      "color": "yellow",
      "x": 1010,
      "y": 3100
    },
    {
      "id": "clients",
      "label": "ClientRegistry\nmodel_id -> LLMClient",
      "type": "component",
      "color": "blue",
      "x": 615,
      "y": 3288
    },
    {
      "id": "adapters",
      "label": "Adapters\nOllama / Anthropic / LangChain / Echo",
      "type": "cloud",
      "color": "gray",
      "x": 615,
      "y": 3464
    },
    {
      "id": "sink",
      "label": "result_sink\n(SQLite, background thread)",
      "type": "database",
      "color": "orange",
      "x": 1403,
      "y": 3288
    },
    {
      "id": "score_all",
      "label": "AgenticRouter.score_all_models(prompt, *,\nimpute_unknown=False, knn_k=10,\nknn_weighting=\"similarity\")\nSIBLING entry point - NOT part of the\ndecompose / orchestrate / repair flow above",
      "type": "component",
      "color": "green",
      "x": 730,
      "y": 362
    },
    {
      "id": "pool_union",
      "label": "pool_ids = union\nrouter.model_ids (trained pool)\n∪ model_profiles.list_profiled_model_ids(cfg)\n(every configs/model_profiles.yaml entry)",
      "type": "component",
      "color": "green",
      "x": 1240,
      "y": 362
    },
    {
      "id": "predict_pool",
      "label": "NIRTRouter.predict_pool_scores_text(\n[prompt], pool_ids, encoder=self.encoder,\nprofile_encoder=self.encoder)",
      "type": "component",
      "color": "green",
      "x": 1750,
      "y": 362
    },
    {
      "id": "resolve_profile",
      "label": "resolve_pool_profile_matrix(pool_ids)\nper id: existing store row / ad hoc render+embed /\n+ kNN blend toward trained pool if impute_unknown\ndeep mechanics: see\ndocs/diagrams/nirt/nirt-training-and-serving.excalidraw",
      "type": "component",
      "color": "orange",
      "x": 2260,
      "y": 362
    },
    {
      "id": "scope_note",
      "label": "Scope boundary, not a bug\nA high score here never implies ClientRegistry can\ndispatch to that model -- separate LookupError.\nroute_decision / pick_helper_model stay scoped to the\nnarrow, ClientRegistry-dispatchable pool (also used by\n_assign_models/route_late and helper_call above)",
      "type": "component",
      "color": "purple",
      "x": 2770,
      "y": 362
    }
  ],
