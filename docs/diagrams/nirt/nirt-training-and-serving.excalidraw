      "boundElements": [],
      "updated": 1791602778651,
      "link": null,
      "locked": false,
      "text": "score(theta,a,b) -> logit\nscalar: logit = a_m . theta_q - b_m\nvector: logit = sum_k a_mk(theta_qk-b_mk)\n+ optional interaction residual (P2c),\ngamma init 0\ny_hat = sigmoid(logit)  (predict_proba)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect-n_score",
      "originalText": "score(theta,a,b) -> logit\nscalar: logit = a_m . theta_q - b_m\nvector: logit = sum_k a_mk(theta_qk-b_mk)\n+ optional interaction residual (P2c),\ngamma init 0\ny_hat = sigmoid(logit)  (predict_proba)",
      "autoResize": true,
      "lineHeight": 1.25
    },
