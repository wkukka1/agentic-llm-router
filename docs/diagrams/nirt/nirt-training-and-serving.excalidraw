      "updated": 1791602778651,
      "link": null,
      "locked": false,
      "text": "Model side (a_m, b_m)\nEITHER free: nn.Embedding(n_models,dim)\n(transductive -- can't score unseen model)\nOR projected: a_head/b_head MLP-or-Linear\non profile e_m (cold-start capable)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect-n_modelside",
      "originalText": "Model side (a_m, b_m)\nEITHER free: nn.Embedding(n_models,dim)\n(transductive -- can't score unseen model)\nOR projected: a_head/b_head MLP-or-Linear\non profile e_m (cold-start capable)",
      "autoResize": true,
      "lineHeight": 1.25
    },
