      "link": null,
      "locked": false,
      "text": "IRTRouterModel (orientation=model_latent)\nALTERNATE / comparison only\n(IRT-Router paper, Song et al. ACL'25)\ntheta_m=[sigmoid] theta_head(e_m)\na_q,b_q = a_head(e_q), b_head(e_q)\nlogit = a_q . theta_m - b_q",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect-n_irtrouter",
      "originalText": "IRTRouterModel (orientation=model_latent)\nALTERNATE / comparison only\n(IRT-Router paper, Song et al. ACL'25)\ntheta_m=[sigmoid] theta_head(e_m)\na_q,b_q = a_head(e_q), b_head(e_q)\nlogit = a_q . theta_m - b_q",
      "autoResize": true,
      "lineHeight": 1.25
    },
