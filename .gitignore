debug_traces/

# keep curated, human-editable taxonomy files under version control
!data/taxonomy/candidate_abilities.yaml
!data/taxonomy/final_taxonomy.yaml
!data/taxonomy/cluster_labels.json

# prompt decomposition
# `.env` is ignored above; the template is committed because it documents
# every variable the heads read.
!.env.example
# The hand-labelled real-prompt set is the project's key asset, not a
# regenerable artifact. Committed deliberately, against the rule above.
!data/handlabelled/
!data/handlabelled/*.parquet
!data/external/
!data/external/*.parquet
!data/synthetic/

# per-machine gateway config (copy of configs/gateway.example.yaml)
configs/gateway.yaml

# LLMRouterBench result tarball, extracted (6.5 GB; scripts/data/download_llmrouterbench.py)
evaluations/LLMRouterBench/results
evaluations/LLMRouterBench/results.nosync/

# a link to data kept outside iCloud (e.g. ~/.cache/aar/processed), and build output
data/processed
build/

# third-party benchmark clone (its own git repo; fetched locally, never committed)
evaluations/LLMRouterBench/
