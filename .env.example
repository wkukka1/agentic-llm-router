# Settings shared by every experiment. Copy to `.env` and edit; `.env` is
# gitignored so local paths never reach the repository.
#
# Precedence: explicit argument > environment variable > .env > built-in default.

# The seed every experiment shares. Changing it changes every split and every
# fit, so results either side of a change are not comparable. Seed variance in
# this project is +/- 3.4 points -- wide enough to invent an effect -- which is
# why this lives in one place rather than as a default in each function.
ROUTER_SEED=20260824

# Where the committed label files live. The hand-labelled prompts are the
# project's asset; everything else under data/ is regenerable.
ROUTER_DATA_DIR=data

# Run directories: trained models, metrics.json, per-row predictions.
ROUTER_ARTIFACTS_DIR=artifacts

# Frozen-encoder cache. Keyed by (model, pooling, max_length, text content), so
# it is safe to share between experiments and across branches. Point this at a
# shared disk to avoid re-encoding the same prompts on every machine.
ROUTER_EMBEDDING_CACHE=data/processed/embeddings
